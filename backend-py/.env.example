# 复制为 .env 后按需修改（.env 不应提交到版本库）

# ---------------- 服务 ----------------
APP_NAME=pingpong-recommendation
HOST=0.0.0.0
PORT=8081
API_PREFIX=/api
DEBUG=true

# ---------------- 数据库 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pingpong_recommendation
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---------------- Redis ----------------
# 关闭后自动降级：无缓存、无限流、token 不绑定 Redis，功能仍可用
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ---------------- JWT ----------------
# 必须与 Java 侧填入同一密钥，否则已签发的 token 无法互认；生产环境请务必改为强随机值
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_TIME=86400
JWT_ALGORITHM=HS512

# ---------------- 限流 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=12

# ---------------- 推荐权重 ----------------
WEIGHT_BROWSE=1.0
WEIGHT_FAVORITE=3.0
WEIGHT_COMMENT=5.0
WEIGHT_PURCHASE=10.0
WEIGHT_TAG=0.6
WEIGHT_CATEGORY=0.3
WEIGHT_PRICE=0.1
SIMILAR_THRESHOLD=0.3
RECOMMEND_CANDIDATE_LIMIT=300

# ---------------- 缓存时长（秒） ----------------
CACHE_PERSONAL_TTL=1800
CACHE_SIMILAR_TTL=3600
CACHE_HOT_TTL=3600

# ---------------- 上传 ----------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880

# ---------------- AI（DeepSeek） ----------------
DEEPSEEK_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 定时任务 ----------------
SCHEDULER_ENABLED=false

# ---------------- CORS ----------------
# JSON 数组格式
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
