# 默认按文本处理并统一为 LF，避免跨平台换行差异造成的整文件 diff
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Maven 启动脚本
mvnw text eol=lf
mvnw.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.pdf binary
*.zip binary
*.docx binary
*.jar binary
*.woff binary
*.woff2 binary

# 让 GitHub 语言统计忽略构建产物目录（如仍有本地残留）
frontend/dist/* linguist-generated=true
backend/target/* linguist-generated=true
